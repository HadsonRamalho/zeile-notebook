# ==========================================
# BACKEND CONFIGURATION (Rust)
# ==========================================

# Database connection string
DATABASE_URL=postgres://zeile:zeilepass@localhost:5432/zeile_db

# Secret for JWT signing (use a long, random string)
JWT_SECRET="your-super-secret-key-here"

# Log level for the Rust server (debug, info, warn, error)
RUST_LOG=info

# ==========================================
# URLS & OAUTH
# ==========================================

# Public URL of the frontend (for CORS and redirection)
FRONTEND_URL=http://localhost:3000

# Public URL of the backend (for OAuth callbacks)
API_URL=http://localhost:3099

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================

# SMTP credentials for sending team invitations
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ==========================================
# WEB PUSH (VAPID)
# ==========================================

# Caminho para a chave privada VAPID (EC prime256v1). Gerar com:
#   openssl ecparam -genkey -name prime256v1 -noout -out vapid_private.pem
VAPID_PRIVATE_KEY_PATH=./vapid_private.pem

# Chave pública VAPID (base64url), derivada da privada acima. Gerar com:
#   openssl ec -in vapid_private.pem -pubout -outform DER | tail -c 65 | base64 | tr '/+' '_-' | tr -d '\n='
# Deve ser igual ao NEXT_PUBLIC_VAPID_PUBLIC_KEY do frontend.
VAPID_PUBLIC_KEY=your_vapid_public_key

# Contato exigido pelo VAPID (claim "sub")
VAPID_SUBJECT=mailto:you@example.com

# ==========================================
# OPTIONAL / SYSTEM
# ==========================================

# Path to wasmtime binary (defaults to system path if not set)
# WASMTIME_PATH=/usr/bin/wasmtime

# Compilers paths (optional, defaults to system path)
# GO_PATH=/usr/local/go/bin/go
# ZIG_PATH=/usr/local/zig/zig
# CPP_PATH=/usr/bin/clang++
