# ==========================================
# BACKEND CONFIGURATION (Rust)
# ==========================================

# Database connection string
DATABASE_URL=postgres://zeile:zeilepass@localhost:5432/zeile_db

# Secret for JWT signing (use a long, random string)
JWT_SECRET="your-super-secret-key-here"

# Log level for the Rust server (debug, info, warn, error)
RUST_LOG=info

# ==========================================
# URLS & OAUTH
# ==========================================

# Public URL of the frontend (for CORS and redirection)
FRONTEND_URL=http://localhost:3000

# Public URL of the backend (for OAuth callbacks)
API_URL=http://localhost:3099

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================

# SMTP credentials for sending team invitations
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ==========================================
# OPTIONAL / SYSTEM
# ==========================================

# Path to wasmtime binary (defaults to system path if not set)
# WASMTIME_PATH=/usr/bin/wasmtime

# Compilers paths (optional, defaults to system path)
# GO_PATH=/usr/local/go/bin/go
# ZIG_PATH=/usr/local/zig/zig
# CPP_PATH=/usr/bin/clang++
