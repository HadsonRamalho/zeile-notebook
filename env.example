# ==========================================
# FRONTEND CONFIGURATION (Next.js)
# ==========================================

# Mode of documentation generation: "JSON", "API", or  "NO_ENDPOINTS"
NEXT_PUBLIC_MODE=API

# Base URL for the general API (used for OpenAPI docs and general requests)
NEXT_PUBLIC_API=http://localhost:3099/api

# Path to the OpenAPI JSON file (required if NEXT_PUBLIC_MODE=JSON)
NEXT_PUBLIC_API_JSON_PATH=content/docs/api-reference/api/endpoints.json

# Backend URL specifically for notebook operations and execution
NEXT_PUBLIC_RUST_NOTEBOOK_API=http://localhost:3099/api

# WebSocket URL for real-time collaboration (Automerge) and Presence
# Note: The code handles protocol replacement (ws/wss), so you can use http/https/ws/wss here.
# In production the page is served over HTTPS, so the backend MUST accept wss://
# (an http/ws value is upgraded to wss:// — a plain ws:// connection is blocked by the browser).
NEXT_PUBLIC_WS_URL=http://localhost:3099/api

# GitHub Personal Access Token (for fetching repository information).
# Server-only: never prefix it with NEXT_PUBLIC_, or Next.js inlines the value
# into the client bundle. Needs zero scopes — it only reads the star count.
GITHUB_TOKEN=your_github_token_here


# ==========================================
# DATABASE CONFIGURATION (Docker / Diesel)
# ==========================================

POSTGRES_USER=zeile
POSTGRES_PASSWORD=zeilepass
POSTGRES_DB=zeile_db

# Full connection string for Diesel and the Rust Backend
DATABASE_URL=postgres://zeile:zeilepass@localhost:5432/zeile_db
