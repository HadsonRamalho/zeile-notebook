# ==========================================
# BACKEND CONFIGURATION (Rust)
# ==========================================

# Database connection string
DATABASE_URL=postgres://zeile:zeilepass@localhost:5432/zeile_db

# Secret for JWT signing (use a long, random string)
JWT_SECRET="your-super-secret-key-here"

# Log level for the Rust server (debug, info, warn, error)
RUST_LOG=info

# ==========================================
# URLS & OAUTH
# ==========================================

# Public URL of the frontend (for redirection)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS. No wildcard is ever used.
# When unset, only http://localhost:3000, http://127.0.0.1:3000 and FRONTEND_URL
# are allowed — set it explicitly in every deployed environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL of the backend (for OAuth callbacks)
API_URL=http://localhost:3099

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================

# SMTP credentials for sending team invitations
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ==========================================
# WEB PUSH (VAPID)
# ==========================================

# Par de chaves VAPID. Gerar com `npx web-push generate-vapid-keys` ou
# qualquer gerador equivalente — a chave privada deve estar em base64url
# "cru" (sem PEM), formato aceito diretamente como env var.
VAPID_PRIVATE_KEY=your_vapid_private_key

# Chave pública VAPID (base64url), do mesmo par acima.
# Deve ser igual ao NEXT_PUBLIC_VAPID_PUBLIC_KEY do frontend.
VAPID_PUBLIC_KEY=your_vapid_public_key

# Contato exigido pelo VAPID (claim "sub")
VAPID_SUBJECT=mailto:you@example.com

# Alternativa a VAPID_PRIVATE_KEY: caminho para um arquivo .pem (EC
# prime256v1) gerado com `openssl ecparam -genkey -name prime256v1 -noout
# -out vapid_private.pem`. Só é usado se VAPID_PRIVATE_KEY não estiver
# definida.
# VAPID_PRIVATE_KEY_PATH=./vapid_private.pem

# ==========================================
# OPTIONAL / SYSTEM
# ==========================================

# Timeout (seconds) for outbound HTTP calls — GitHub and OAuth. Default 10, max 120.
# HTTP_CLIENT_TIMEOUT_SECS=10

# Timeout (seconds) for SMTP. Default 15, max 120.
# SMTP_TIMEOUT_SECS=15

# Postgres pool size. Default 50.
# DATABASE_POOL_SIZE=50

# Path to wasmtime binary (defaults to system path if not set)
# WASMTIME_PATH=/usr/bin/wasmtime

# Compilers paths (optional, defaults to system path)
# GO_PATH=/usr/local/go/bin/go
# ZIG_PATH=/usr/local/zig/zig
# CPP_PATH=/usr/bin/clang++

# Seconds to wait for open connections to finish during graceful shutdown, before the
# final Automerge checkpoint runs anyway. Default 5.
# SHUTDOWN_GRACE_SECS=5

# Session token for POST /internal/shutdown. Set by the desktop shell only; when unset,
# the endpoint answers 404. The endpoint also requires a loopback peer.
# ZEILE_SHELL_TOKEN=

# Shared build cache mounted read-write at /cache inside the compile sandbox. Without it
# every new session recompiles the Go/Zig standard library. Default files/.build-cache.
# ZEILE_BUILD_CACHE=files/.build-cache

# Token for scraping GET /api/metrics from outside the host, sent in the
# x-zeile-metrics-token header. Loopback callers are allowed without it, and a Zeile
# admin JWT also works. When unset, only loopback and admins can scrape.
# ZEILE_METRICS_TOKEN=

# Retention of the per-execution log files under logs/, in days. Default 3.
# ZEILE_LOG_RETENTION_DAYS=3

# Turns off the global request ceiling. Set only for load testing, which drives many
# clients from a single machine.
# ZEILE_RATE_LIMIT_OFF=false
